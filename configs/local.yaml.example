# Per-machine config. COPY to configs/local.yaml (gitignored) and edit for THIS machine.
# The same case YAML then runs unchanged on every machine.

# Machine 3 (srye-deltae-05) example:
smart_ds_base: "D:/lvg"     # topology smart_ds_root = smart_ds_base / topology.smart_ds_relpath
# Holds Metadata_<ST>_Residential/ and Metadata_<ST>_Commercial/<ST>_baseline_metadata_and_annual_results.csv, ST = NC, TX.
eulp_metadata_root: "D:/lvg/eulp_metadata"
runs_root: "runs"           # per-case provenance output (repo-relative or absolute)
# Only for 7_circuit_instantiation/fetch_tou_rates.py, a maintainer step outside --all:
# a text file that holds an OpenEI API key.
openei_api_key_file: "path/to/OPENEI_API_KEY.txt"
# Only for 7_circuit_instantiation/build_nhts_extract.py: the unpacked 2017 NHTS Csv.zip.
nhts2017_csv_dir: "path/to/nhts2017/csv"
# Only for 7_circuit_instantiation/build_evwatts_extract.py: the EV WATTS public tables.
evwatts_raw_dir: "path/to/evwatts.public"
# The EV WATTS extract folder, outside the repository; the Phase 7 deploy reads it
# under ev_cars evwatts_sessions (the default) and session_rows.
evwatts_extract_dir: "path/to/evwatts_extract"

# run_case.py derives the parquet roots from topology_registry.yaml (the parquet_data
# folder beside each topology's opendss tree). local.yaml holds no parquet path.
